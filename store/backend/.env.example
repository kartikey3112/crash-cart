# Copy to .env for local overrides. Never commit the real .env.
# In production (Render) set these as environment variables instead.
CRASHCART_ENVIRONMENT=dev
CRASHCART_DATABASE_URL=sqlite:///./crashcart.db
CRASHCART_JWT_SECRET=change-me
CRASHCART_TEST_TOKEN=change-me
CRASHCART_ADMIN_EMAIL=admin@crashcart.test
CRASHCART_ADMIN_PASSWORD=change-me
CRASHCART_CORS_ORIGINS=http://localhost:5173
